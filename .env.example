# =========================================================================
# GENESIS WORKPLACE ENVIRONMENT CONFIGURATION
# =========================================================================

# HTTP Server Port (Default: 8888)
PORT=8888

# Optional: Google OAuth 2.0 Credentials for Live Quota Telemetry & Auto Token Refresher
# If provided, enables automatic token refreshing with Google Cloud Code API
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
